{
  "policy_version": "2.0.0",
  "effective_date": "2026-09-07",
  "requirement": "Every new artwork is generated by gpt-image-2 from a prompt authored by an actual Astra agent.",
  "art_prompt_author_model": "gpt-6-astra",
  "art_prompt_author_effort": "max",
  "art_prompt_author_role_ids": [
    "W02-C1-BUILD",
    "W02-C2-BUILD"
  ],
  "image_generation_model": "gpt-image-2",
  "accepted_resolved_image_model_ids": [
    "gpt-image-2",
    "gpt-image-2-2026-04-21"
  ],
  "resolved_snapshot_requires_alias_evidence": true,
  "allow_model_substitution": false,
  "default_descendant_model": "gpt-5.6-luna",
  "default_descendant_effort": "max",
  "max_descendant_depth": 3,
  "max_open_descendants": 250,
  "art_method": "generate",
  "required_origin": "astra_authored_gpt_image_2",
  "new_art_scope": [
    "logos",
    "wordmarks",
    "icons",
    "patterns",
    "illustrations",
    "banners",
    "social_cards",
    "thumbnails",
    "overlays",
    "title_scenes",
    "decorative_state_art",
    "presentation_diagrams",
    "exported_charts",
    "every_future_campaign_artwork"
  ],
  "not_art": [
    "authentic_gameplay_evidence",
    "unedited_historical_archive",
    "reference_metadata",
    "functional_html_css_and_accessible_text",
    "captions_and_transcripts"
  ],
  "allowed_export_operations": [
    "identity",
    "resize",
    "crop",
    "encode",
    "lossless_optimize",
    "metadata_strip",
    "sprite_slice",
    "assemble_unchanged_frames",
    "alpha_preserving_export"
  ],
  "forbidden_art_origins": [
    "hand_authored_svg",
    "canvas_drawing",
    "css_illustration",
    "python_drawing",
    "stock_art",
    "unmodified_legacy_art",
    "other_image_model",
    "traced_or_repainted_substitute"
  ],
  "default_initial_concept_limit": 3,
  "default_revision_round_limit": 2,
  "genesis_status": "planned_not_executed",
  "generation_records_required_per_creative_master": true,
  "final_export_link_to_generation_required": true,
  "no_fabricated_runtime_or_gameplay_evidence": true
}
