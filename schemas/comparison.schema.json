{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ascension.example/schemas/comparison-v1.json",
  "title": "Public comparison context",
  "description": "A comparison describes matching conditions and limitations. It does not rank intelligence from a convenience sample.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "comparison-v1"
    },
    "comparison_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,119}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "comparison_kind": {
      "enum": [
        "same_start",
        "exploratory"
      ]
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "public_run_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "game_build": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "seed_policy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "observation_policy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "action_interface": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "budget": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "retry_policy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "intervention_policy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "start_evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "artifact_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "artifact_path",
              "artifact_digest"
            ]
          }
        },
        "required": [
          "public_run_id",
          "label",
          "game_build",
          "seed_policy",
          "observation_policy",
          "action_interface",
          "budget",
          "retry_policy",
          "intervention_policy"
        ]
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "same_start_required": {
          "type": "boolean"
        },
        "same_game_build": {
          "type": "boolean"
        },
        "same_seed_policy": {
          "type": "boolean"
        },
        "same_observation_policy": {
          "type": "boolean"
        },
        "same_action_interface": {
          "type": "boolean"
        },
        "same_budget": {
          "type": "boolean"
        },
        "retries_declared": {
          "type": "boolean"
        },
        "interventions_declared": {
          "type": "boolean"
        },
        "ranking_claims_allowed": {
          "const": false
        }
      },
      "required": [
        "same_start_required",
        "same_game_build",
        "same_seed_policy",
        "same_observation_policy",
        "same_action_interface",
        "same_budget",
        "retries_declared",
        "interventions_declared",
        "ranking_claims_allowed"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "comparison_id",
    "title",
    "comparison_kind",
    "runs",
    "rules",
    "limitations"
  ]
}
