{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified artwork generation provenance",
  "description": "Completed provenance record for either the legacy Astra to gpt-image-2 route or the explicitly user-authorized root image-tool route. The unfilled execution template is intentionally not a verified record. Runtime/tool evidence must be independently inspected.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "generation_route": {
      "enum": [
        "astra_gpt_image_2",
        "user_authorized_root_image_tool"
      ]
    },
    "author_role_id": {
      "enum": [
        "W02-C1-BUILD",
        "W02-C2-BUILD",
        "ROOT"
      ]
    },
    "author_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "author_parent_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "author_runtime_evidence_reference": {
      "type": "string",
      "minLength": 1
    },
    "prompt_path": {
      "type": "string",
      "minLength": 1
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "tool_execution_reference": {
      "type": "string",
      "minLength": 1
    },
    "image_model_evidence_reference": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_reference": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "in_progress",
        "blocked",
        "verified"
      ]
    },
    "test_fixture": {
      "type": "boolean"
    },
    "author_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "image_model_requested": {
      "type": "string",
      "minLength": 1
    },
    "image_model_observed": {
      "type": "string",
      "minLength": 1
    },
    "image_backend": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_alias_evidence_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_revised_prompt_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_revised_prompt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "revised_prompt_astra_review_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rights_reference": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reference",
          "sha256",
          "rights_reference"
        ]
      }
    },
    "raw_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "format": {
            "enum": [
              "png",
              "webp",
              "jpeg",
              "jpg"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "format",
          "width",
          "height"
        ]
      }
    },
    "requested_author_model": {
      "type": "string",
      "minLength": 1
    },
    "requested_author_effort": {
      "type": "string",
      "minLength": 1
    },
    "accepted_author_model": {
      "type": "string",
      "minLength": 1
    },
    "accepted_author_effort": {
      "type": "string",
      "minLength": 1
    },
    "observed_author_model": {
      "type": "string",
      "minLength": 1
    },
    "observed_author_effort": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_alias_evidence_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "user_authorization_reference": {
      "type": "string",
      "minLength": 1
    },
    "user_authorization_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "record_id",
    "asset_id",
    "author_role_id",
    "author_agent_id",
    "author_parent_id",
    "author_runtime_evidence_reference",
    "prompt_path",
    "tool_name",
    "tool_execution_reference",
    "image_model_evidence_reference",
    "reviewer_reference",
    "created_at",
    "status",
    "test_fixture",
    "author_depth",
    "image_model_requested",
    "image_model_observed",
    "prompt_sha256",
    "reference_inputs",
    "raw_outputs",
    "requested_author_model",
    "requested_author_effort",
    "accepted_author_model",
    "accepted_author_effort",
    "observed_author_model",
    "observed_author_effort"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "generation_route": {
            "const": "user_authorized_root_image_tool"
          }
        },
        "required": [
          "generation_route"
        ]
      },
      "then": {
        "properties": {
          "author_role_id": {"const": "ROOT"},
          "author_agent_id": {"const": "root"},
          "author_parent_id": {"type": "null"},
          "author_depth": {"const": 0},
          "requested_author_model": {"const": "unknown"},
          "requested_author_effort": {"const": "unknown"},
          "accepted_author_model": {"const": "unknown"},
          "accepted_author_effort": {"const": "unknown"},
          "observed_author_model": {"const": "unknown"},
          "observed_author_effort": {"const": "unknown"},
          "image_model_requested": {"const": "unknown"},
          "image_model_observed": {"const": "unknown"},
          "image_backend": {"const": "unspecified"},
          "tool_name": {"const": "image_gen__imagegen"},
          "user_authorization_reference": {"const": "art/root-generation-authorization.json"}
        },
        "required": [
          "generation_route",
          "image_backend",
          "user_authorization_reference",
          "user_authorization_sha256"
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "generation_route": {
              "const": "user_authorized_root_image_tool"
            }
          },
          "required": [
            "generation_route"
          ]
        }
      },
      "then": {
        "properties": {
          "author_parent_id": {
            "type": "string",
            "minLength": 1
          },
          "author_role_id": {
            "enum": [
              "W02-C1-BUILD",
              "W02-C2-BUILD"
            ]
          },
          "author_depth": {"const": 3},
          "image_model_requested": {"const": "gpt-image-2"},
          "image_model_observed": {
            "enum": [
              "gpt-image-2",
              "gpt-image-2-2026-04-21"
            ]
          },
          "requested_author_model": {"const": "gpt-6-astra"},
          "requested_author_effort": {"const": "max"},
          "accepted_author_model": {"const": "gpt-6-astra"},
          "accepted_author_effort": {"const": "max"},
          "observed_author_model": {"const": "gpt-6-astra"},
          "observed_author_effort": {"const": "max"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "test_fixture": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "image_model_observed": {
            "const": "gpt-image-2-2026-04-21"
          }
        },
        "required": [
          "image_model_observed"
        ]
      },
      "then": {
        "properties": {
          "snapshot_alias_evidence_reference": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_alias_evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "snapshot_alias_evidence_reference",
          "snapshot_alias_evidence_sha256"
        ]
      }
    }
  ]
}
