{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digest-bound publication or operation approval",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_reference": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "operation": {
      "enum": [
        "publish_asset",
        "publish_run",
        "rename_repository",
        "deploy",
        "merge",
        "send_campaign",
        "update_public_settings"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowed_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_notes": {
      "type": "string",
      "minLength": 1
    },
    "revoked": {
      "type": "boolean"
    }
  },
  "required": [
    "approval_id",
    "authority_reference",
    "approved_at",
    "operation",
    "target",
    "source_digest",
    "allowed_surfaces",
    "allowed_fields",
    "scope_notes",
    "revoked"
  ]
}
